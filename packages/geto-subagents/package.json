  "repository": {
    "type": "git",
    "url": "git+https://github.com/mr-jones123/geto.git"
  },
  "files": [
    "index.ts",
    "agents.ts",
    "README.md"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
